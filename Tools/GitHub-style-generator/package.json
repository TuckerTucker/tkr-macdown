{
  "name": "github-style-generator",
  "version": "1.0.0",
  "description": "Generates GitHub style for MacDown.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MacDownApp/macdown/tree/master/Tools/GitHub-theme-generator"
  },
  "author": "Franklin Yu",
  "license": "MIT",
  "scripts": {
    "build": "sass --quiet --load-path node_modules index.sass | sed s/.markdown-body/body/"
  },
  "dependencies": {
    "primer-markdown": "^4.0.0",
    "sass": "^1.77.0"
  },
  "overrides": {
    "lodash": ">=4.17.21",
    "minimist": ">=1.2.6",
    "tough-cookie": ">=4.1.3"
  }
}
