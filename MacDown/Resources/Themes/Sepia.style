# Sepia - a paper theme evoking an aged book page.
# Pairs with the Styles/Sepia.css preview style; both share the paper color.
# Colors only; every element keeps the editor font chosen in Preferences.

editor
foreground: 43352A
background: F4ECD8
caret: 43352A

editor-selection
background: E6D9BC

editor-current-line
background: EFE5CD

H1
foreground: 43352A
font-style: bold

H2
foreground: 43352A
font-style: bold

H3
foreground: 43352A
font-style: bold

H4
foreground: 43352A
font-style: bold

H5
foreground: 43352A
font-style: bold

H6
foreground: 43352A
font-style: bold

EMPH
font-style: italic

STRONG
font-style: bold

LIST_BULLET
foreground: 6E5D4A

LIST_ENUMERATOR
foreground: 6E5D4A

BLOCKQUOTE
foreground: 6E5D4A

COMMENT
foreground: 6E5D4A

HRULE
foreground: 6E5D4A

LINK
foreground: 7A4E2D

AUTO_LINK_URL
foreground: 7A4E2D

AUTO_LINK_EMAIL
foreground: 7A4E2D

REFERENCE
foreground: 7A4E2D

IMAGE
foreground: 7A4E2D

